# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- RocketRide Cloud ---
ROCKETRIDE_URI=https://api.rocketride.ai
# The docs disagree on the key's name: PyPI says ROCKETRIDE_APIKEY, the GitHub
# README says ROCKETRIDE_AUTH. Set both to the same token until confirmed.
ROCKETRIDE_APIKEY=
ROCKETRIDE_AUTH=

# --- Hotdata ---
# From `hotdata auth login` or the Hotdata dashboard.
HOTDATA_API_KEY=
HOTDATA_WORKSPACE=
