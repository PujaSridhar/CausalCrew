# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- RocketRide Cloud ---
# Name confirmed from the installed SDK (rocketride 1.3.0 reads ROCKETRIDE_APIKEY).
ROCKETRIDE_URI=https://api.rocketride.ai
ROCKETRIDE_APIKEY=

# --- Hotdata ---
# The CLI reads these. The Python SDK reads no env vars, so our code passes
# them to hotdata.Configuration(api_key=..., workspace_id=...) explicitly.
HOTDATA_API_KEY=
HOTDATA_WORKSPACE=

# --- Cognee (Anthropic LLM + local fastembed embeddings, no OpenAI needed) ---
# Per docs.cognee.ai/setup-configuration. If only the LLM is set, embeddings
# silently default to OpenAI, so keep the EMBEDDING_* block.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-5-20250929
LLM_API_KEY=
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
