{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Demo A: broken data",
      "type": "debugpy",
      "request": "launch",
      "module": "causal_crew.run",
      "args": ["--broken"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "Demo B: clean data",
      "type": "debugpy",
      "request": "launch",
      "module": "causal_crew.run",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "Check environment",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/check_env.py",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    }
  ]
}
